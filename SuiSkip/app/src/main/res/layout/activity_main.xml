<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SuiSkip v2.0.0"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="包名: com.sui.skip | ColorOS / realme UI 专属三模跳广告引擎"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="运行状态：检测中..."
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_perm_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="写入安全设置权限：检测中..."
                android:textColor="#A7F3D0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_skip_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="累计已跳过广告：0 次"
                android:textColor="#38BDF8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="核心增强特性（自动开启 &amp; 触摸防卡顿）"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 功能 1：无障碍 自动开启 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1E293B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无障碍 自动开启"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="· 永久授予「写入安全设置权限」
· 应用可自行控制开关无障碍"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_auto_enable_a11y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 功能 2：触摸优化 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1E293B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="触摸优化"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="· 由特权服务完成点击和滑动
· 减少无障碍引起的触摸卡顿"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/switch_touch_optimization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="工作模式切换（三选一）"
            android:textColor="#E2E8F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_work_modes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1E293B"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_mode_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="模式一：标准无障碍模式（默认无需 Root）"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rb_mode_shizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="模式二：Shizuku 增强模式（自动授权 + 特权触摸）"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rb_mode_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="模式三：ROOT 终极模式（无障碍永生保活 + OOM 锁定）"
                android:textColor="#F8FAFC" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_toggle_self_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="应用内一键自控开关无障碍服务" />

        <Button
            android:id="@+id/btn_open_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="手动前往系统无障碍设置" />

        <Button
            android:id="@+id/btn_oplus_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="一键配置 ColorOS / realme UI 电池后台白名单" />

        <Button
            android:id="@+id/btn_self_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="运行全量引擎自检（验证规则、权限与触摸优化）" />
    </LinearLayout>
</ScrollView>
